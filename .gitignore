# Python
__pycache__/
*.pyc
.venv/

# Node（Remotion 工程在 projects/*/remotion-app/，模板不带 node_modules）
node_modules/
dist/
build/
out/

# 媒体产物（全局兜底，不进 git，脚本可复跑）
*.mp4
*.webm

# PPT / PDF 产物
*.pptx
*.pdf
!docs/**/*.pdf

# 成品大媒体不入库；制作配方、归档清单、字幕、发布配置和封面必须入库
products/**
!products/**/
!products/**/*.md
!products/**/recipe/**
!products/**/archive.json
!products/**/*.srt
!products/**/gen-*.py
!products/**/render-*.py
!products/**/primitives.py
!products/**/cover*.png
!products/**/*-cover*.png
!products/**/deliverables/**/*.json
!products/**/deliverables/**/*-contact-sheet.png
# 后续发布/复盘数据独立于制作快照；只保留必要且脱敏的文本数据
!products/**/operations/**/*.json
!products/**/operations/**/*.csv
products/**/operations/**/auth.json
products/**/operations/**/cookie.json
products/**/operations/**/cookies.json
products/**/operations/**/storage-state.json
products/**/media/
products/**/recipe/**/node_modules/
products/**/recipe/**/frames/
products/**/recipe/**/__pycache__/
products/**/recipe/**/*.mp4
products/**/recipe/**/*.wav

# 施工区：项目素材与本地产物不入库（场景代码、设计文档、生成数据入库）
projects/*/remotion-app/public/
projects/*/remotion-app/out/

# OS / 编辑器
.DS_Store
Thumbs.db

# .claude/skills 是指向 skills/ 的本机 junction（绝对路径，不可跨机）
.claude/skills/
.agents/skills/
.cache/
**/.studio/

# 渲染核查产物（PNG 等）
output/
projects/resume-generator/_qa*.png

# 项目 QA / 发布过程截图与渲染日志（核查产物可复跑，不入库；发布截图含登录态页面）
projects/*/qa/
projects/*/pw/qa/
projects/*/render/
*.log

# Playwright MCP 临时快照
.playwright-mcp/

# VMBL 升级核查基线（still 对照产物，不入库）
skills/video-motion/templates/remotion-app/.baseline/
