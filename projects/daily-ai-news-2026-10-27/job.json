{
  "schemaVersion": 1,
  "steps": [
    {
      "id": "deps",
      "command": [
        "node",
        "scripts/deps.mjs"
      ],
      "inputs": [
        "remotion-app/package.json",
        "remotion-app/package-lock.json",
        "scripts/deps.mjs"
      ],
      "outputs": [
        ".studio/deps.json"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "recording-review",
      "command": [
        "python",
        "scripts/review-recording.py"
      ],
      "inputs": [
        "scripts/review-recording.py",
        "audio/asr/raw-words.json",
        "audio/source/narration-original.mp3",
        "audio/source/narration-asr.wav",
        "audio/source/narration-decoded.wav",
        "audio/source/manuscript-received.md"
      ],
      "outputs": [
        "audio/recording-review.json",
        "audio/asr/reviewed-transcript.txt",
        "narration-recorded.md"
      ],
      "timeoutSeconds": 180
    },
    {
      "id": "inputs",
      "command": [
        "python",
        "scripts/build-narrated-inputs.py"
      ],
      "inputs": [
        "scripts/build-narrated-inputs.py",
        "audio/recording-review.json",
        "claims.json",
        "ranking.json",
        "assets"
      ],
      "outputs": [
        "timeline.json",
        "script.json",
        "storyboard.json",
        "audio.json",
        "audio-voice.json",
        "captions.srt",
        "captions.cues.json",
        "qc.json"
      ],
      "timeoutSeconds": 180
    },
    {
      "id": "plan",
      "command": [
        "node",
        "{repo}/skills/content-director/scripts/validate-plan.mjs",
        "{project}"
      ],
      "inputs": [
        "storyboard.json"
      ],
      "outputs": [],
      "timeoutSeconds": 180
    },
    {
      "id": "voice",
      "command": [
        "node",
        "{repo}/scripts/studio.mjs",
        "audio",
        "--project",
        "{project}",
        "--config",
        "audio-voice.json",
        "--out",
        "audio/voice-clean.wav"
      ],
      "inputs": [
        "audio-voice.json",
        "audio/source/narration-decoded.wav"
      ],
      "outputs": [
        "audio/voice-clean.wav",
        "audio/voice-clean.wav.json"
      ],
      "timeoutSeconds": 180
    },
    {
      "id": "audio",
      "command": [
        "node",
        "{repo}/scripts/studio.mjs",
        "audio",
        "--project",
        "{project}"
      ],
      "inputs": [
        "audio.json",
        "audio/voice-clean.wav",
        "assets/carefree.mp3"
      ],
      "outputs": [
        "audio/mix.wav",
        "audio/mix.wav.json"
      ],
      "timeoutSeconds": 180
    },
    {
      "id": "typecheck",
      "command": [
        "node",
        "remotion-app/node_modules/typescript/bin/tsc",
        "--noEmit",
        "--project",
        "remotion-app/tsconfig.json"
      ],
      "inputs": [
        "remotion-app/src",
        "remotion-app/tsconfig.json",
        "timeline.json",
        "ranking.json"
      ],
      "outputs": [],
      "timeoutSeconds": 180
    },
    {
      "id": "stills",
      "command": [
        "node",
        "scripts/render.mjs",
        "stills"
      ],
      "inputs": [
        "scripts/render.mjs",
        "remotion-app/src",
        "timeline.json",
        "ranking.json",
        "audio/mix.wav"
      ],
      "outputs": [
        "render/stills",
        "render/cover.png"
      ],
      "timeoutSeconds": 600
    },
    {
      "id": "render",
      "command": [
        "node",
        "scripts/render.mjs",
        "video"
      ],
      "inputs": [
        "scripts/render.mjs",
        "remotion-app/src",
        "timeline.json",
        "ranking.json",
        "audio/mix.wav",
        "remotion-app/public/edition/assets"
      ],
      "outputs": [
        "render/daily-ai-news-2026-10-27.mp4",
        "render/daily-ai-news-2026-10-27.mp4.json"
      ],
      "timeoutSeconds": 3600
    },
    {
      "id": "qc",
      "command": [
        "node",
        "{repo}/skills/media-qc/scripts/check.mjs",
        "--project",
        "{project}",
        "--video",
        "render/daily-ai-news-2026-10-27.mp4",
        "--srt",
        "captions.srt",
        "--require-audio"
      ],
      "inputs": [
        "render/daily-ai-news-2026-10-27.mp4",
        "render/daily-ai-news-2026-10-27.mp4.json",
        "captions.srt",
        "qc.json"
      ],
      "outputs": [
        "qa/media-report.json",
        "qa/media-report-contact-sheet.png"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "publish-materials",
      "command": [
        "node",
        "scripts/prepare-publish.mjs"
      ],
      "inputs": [
        "variants.json",
        "storyboard.json",
        "timeline.json",
        "captions.srt"
      ],
      "outputs": [
        "publish-plan.json",
        "exports/bili/form.json",
        "exports/bili/captions.srt"
      ],
      "timeoutSeconds": 180
    }
  ]
}
