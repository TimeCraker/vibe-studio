  "cues": [
    {
      "id": 1,
      "scene": "overview",
      "text": "各位观众们大家好",
      "from": 849,
      "to": 933,
      "sourceStart": 0.27,
      "sourceEnd": 1.67
    },
    {
      "id": 2,
      "scene": "overview",
      "text": "欢迎收看今日 AI 资讯",
      "from": 946,
      "to": 1025,
      "sourceStart": 1.89,
      "sourceEnd": 3.21
    },
    {
      "id": 3,
      "scene": "overview",
      "text": "今天的主要资讯有三件",
      "from": 1081,
      "to": 1178,
      "sourceStart": 4.13,
      "sourceEnd": 5.75
    },
    {
      "id": 4,
      "scene": "overview",
      "text": "第一个是DeepSeek开源了一套让AI同时干多件事的",
      "from": 1203,
      "to": 1435,
      "sourceStart": 6.17,
      "sourceEnd": 10.03
    },
    {
      "id": 5,
      "scene": "overview",
      "text": "架构",
      "from": 1435,
      "to": 1457,
      "sourceStart": 10.03,
      "sourceEnd": 10.41
    },
    {
      "id": 6,
      "scene": "overview",
      "text": "苹果国行版Apple智能接入了阿里千问",
      "from": 1499,
      "to": 1732,
      "sourceStart": 11.11,
      "sourceEnd": 14.99
    },
    {
      "id": 7,
      "scene": "overview",
      "text": "还有国内团队开源了一个生物分子大模型",
      "from": 1745,
      "to": 1903,
      "sourceStart": 15.21,
      "sourceEnd": 17.83
    },
    {
      "id": 8,
      "scene": "ds-what",
      "text": "10月31日晚上",
      "from": 1951,
      "to": 2018,
      "sourceStart": 18.63,
      "sourceEnd": 19.75
    },
    {
      "id": 9,
      "scene": "ds-what",
      "text": "DeepSeekHarness团队发了一篇长文",
      "from": 2041,
      "to": 2185,
      "sourceStart": 20.13,
      "sourceEnd": 22.53
    },
    {
      "id": 10,
      "scene": "ds-what",
      "text": "讲他们怎么设计一个一直在线的agent",
      "from": 2198,
      "to": 2385,
      "sourceStart": 22.75,
      "sourceEnd": 25.87
    },
    {
      "id": 11,
      "scene": "ds-what",
      "text": "同时把研究原型放在了github",
      "from": 2398,
      "to": 2546,
      "sourceStart": 26.09,
      "sourceEnd": 28.55
    },
    {
      "id": 12,
      "scene": "ds-what",
      "text": "它跟常见的编程助手不太一样",
      "from": 2588,
      "to": 2707,
      "sourceStart": 29.25,
      "sourceEnd": 31.23
    },
    {
      "id": 13,
      "scene": "ds-what",
      "text": "你把它接到一个代码仓库",
      "from": 2728,
      "to": 2837,
      "sourceStart": 31.59,
      "sourceEnd": 33.41
    },
    {
      "id": 14,
      "scene": "ds-what",
      "text": "也可以顺手接上飞书群",
      "from": 2846,
      "to": 2949,
      "sourceStart": 33.55,
      "sourceEnd": 35.27
    },
    {
      "id": 15,
      "scene": "ds-what",
      "text": "有权限的人在群里提需求",
      "from": 2961,
      "to": 3087,
      "sourceStart": 35.47,
      "sourceEnd": 37.57
    },
    {
      "id": 16,
      "scene": "ds-what",
      "text": "它自己开一个工作区去做",
      "from": 3107,
      "to": 3202,
      "sourceStart": 37.91,
      "sourceEnd": 39.49
    },
    {
      "id": 17,
      "scene": "ds-what",
      "text": "做完回到原来的会话里回复",
      "from": 3225,
      "to": 3327,
      "sourceStart": 39.87,
      "sourceEnd": 41.57
    },
    {
      "id": 18,
      "scene": "ds-what",
      "text": "比如直接提一个PR",
      "from": 3345,
      "to": 3435,
      "sourceStart": 41.87,
      "sourceEnd": 43.37
    },
    {
      "id": 19,
      "scene": "ds-what",
      "text": "几件事情可以同时推进",
      "from": 3451,
      "to": 3544,
      "sourceStart": 43.63,
      "sourceEnd": 45.19
    },
    {
      "id": 20,
      "scene": "ds-what",
      "text": "互不打断",
      "from": 3556,
      "to": 3592,
      "sourceStart": 45.39,
      "sourceEnd": 45.99
    },
    {
      "id": 21,
      "scene": "ds-arch",
      "text": "背后是一套分层设计",
      "from": 3613,
      "to": 3721,
      "sourceStart": 46.33,
      "sourceEnd": 48.13
    },
    {
      "id": 22,
      "scene": "ds-arch",
      "text": "上面一层只负责派活和回话",
      "from": 3730,
      "to": 3851,
      "sourceStart": 48.29,
      "sourceEnd": 50.31
    },
    {
      "id": 23,
      "scene": "ds-arch",
      "text": "下面一层是互不干扰的",
      "from": 3869,
      "to": 3963,
      "sourceStart": 50.61,
      "sourceEnd": 52.17
    },
    {
      "id": 24,
      "scene": "ds-arch",
      "text": "执行单元各干各的",
      "from": 3968,
      "to": 4040,
      "sourceStart": 52.25,
      "sourceEnd": 53.45
    },
    {
      "id": 25,
      "scene": "ds-arch",
      "text": "所以它在后台跑长任务时",
      "from": 4061,
      "to": 4185,
      "sourceStart": 53.81,
      "sourceEnd": 55.87
    },
    {
      "id": 26,
      "scene": "ds-arch",
      "text": "前台照样能接收新指令",
      "from": 4214,
      "to": 4331,
      "sourceStart": 56.35,
      "sourceEnd": 58.31
    },
    {
      "id": 27,
      "scene": "ds-arch",
      "text": "笔记本合上了任务也不断",
      "from": 4342,
      "to": 4432,
      "sourceStart": 58.49,
      "sourceEnd": 59.99
    },
    {
      "id": 28,
      "scene": "ds-arch",
      "text": "外面还挂了一个独立的看门狗",
      "from": 4432,
      "to": 4574,
      "sourceStart": 59.99,
      "sourceEnd": 62.35
    },
    {
      "id": 29,
      "scene": "ds-arch",
      "text": "专门盯每个任务有没有真正在往前推进",
      "from": 4576,
      "to": 4790,
      "sourceStart": 62.39,
      "sourceEnd": 65.95
    },
    {
      "id": 30,
      "scene": "ds-bench",
      "text": "文章给了一组初步数据",
      "from": 4834,
      "to": 4954,
      "sourceStart": 66.69,
      "sourceEnd": 68.69
    },
    {
      "id": 31,
      "scene": "ds-bench",
      "text": "任务完成中位数12.4分",
      "from": 4969,
      "to": 5113,
      "sourceStart": 68.93,
      "sourceEnd": 71.33
    },
    {
      "id": 32,
      "scene": "ds-bench",
      "text": "作者自己也说",
      "from": 5164,
      "to": 5221,
      "sourceStart": 72.19,
      "sourceEnd": 73.13
    },
    {
      "id": 33,
      "scene": "ds-bench",
      "text": "实验用的是合成的负载和简化环境",
      "from": 5261,
      "to": 5444,
      "sourceStart": 73.81,
      "sourceEnd": 76.85
    },
    {
      "id": 34,
      "scene": "ds-bench",
      "text": "只能当初步参考",
      "from": 5459,
      "to": 5656,
      "sourceStart": 77.11,
      "sourceEnd": 80.39
    },
    {
      "id": 35,
      "scene": "ds-limits",
      "text": "有一点得说清楚",
      "from": 5683,
      "to": 5746,
      "sourceStart": 80.83,
      "sourceEnd": 81.89
    },
    {
      "id": 36,
      "scene": "ds-limits",
      "text": "仓库里写得很明白",
      "from": 5768,
      "to": 5825,
      "sourceStart": 82.25,
      "sourceEnd": 83.21
    },
    {
      "id": 37,
      "scene": "ds-limits",
      "text": "这是研究原型",
      "from": 5830,
      "to": 5873,
      "sourceStart": 83.29,
      "sourceEnd": 84.01
    },
    {
      "id": 38,
      "scene": "ds-limits",
      "text": "不是DeepSeek的正式产品",
      "from": 5877,
      "to": 6005,
      "sourceStart": 84.07,
      "sourceEnd": 86.21
    },
    {
      "id": 39,
      "scene": "ds-limits",
      "text": "为了公开做过改编",
      "from": 6050,
      "to": 6179,
      "sourceStart": 86.95,
      "sourceEnd": 89.11
    },
    {
      "id": 40,
      "scene": "ds-limits",
      "text": "想试的话",
      "from": 6188,
      "to": 6221,
      "sourceStart": 89.25,
      "sourceEnd": 89.81
    },
    {
      "id": 41,
      "scene": "ds-limits",
      "text": "先去仓库看安装文档",
      "from": 6232,
      "to": 6355,
      "sourceStart": 89.99,
      "sourceEnd": 92.03
    },
    {
      "id": 42,
      "scene": "ds-limits",
      "text": "前提是你本来就在用DeepSeekHarness",
      "from": 6362,
      "to": 6526,
      "sourceStart": 92.15,
      "sourceEnd": 94.89
    },
    {
      "id": 43,
      "scene": "apple-change",
      "text": "接着是苹果",
