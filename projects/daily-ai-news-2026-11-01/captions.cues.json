{
  "subtitles": [
    {
      "start": 14.15,
      "end": 15.55,
      "text": "各位观众们大家好"
    },
    {
      "start": 15.767,
      "end": 17.083,
      "text": "欢迎收看今日 AI 资讯"
    },
    {
      "start": 18.017,
      "end": 19.633,
      "text": "今天的主要资讯有三件"
    },
    {
      "start": 20.05,
      "end": 23.917,
      "text": "第一个是DeepSeek开源了一套让AI同时干多件事的"
    },
    {
      "start": 23.917,
      "end": 24.283,
      "text": "架构"
    },
    {
      "start": 24.983,
      "end": 28.867,
      "text": "苹果国行版Apple智能接入了阿里千问"
    },
    {
      "start": 29.083,
      "end": 31.717,
      "text": "还有国内团队开源了一个生物分子大模型"
    },
    {
      "start": 32.517,
      "end": 33.633,
      "text": "10月31日晚上"
    },
    {
      "start": 34.017,
      "end": 36.417,
      "text": "DeepSeekHarness团队发了一篇长文"
    },
    {
      "start": 36.633,
      "end": 39.75,
      "text": "讲他们怎么设计一个一直在线的agent"
    },
    {
      "start": 39.967,
      "end": 42.433,
      "text": "同时把研究原型放在了github"
    },
    {
      "start": 43.133,
      "end": 45.117,
      "text": "它跟常见的编程助手不太一样"
    },
    {
      "start": 45.467,
      "end": 47.283,
      "text": "你把它接到一个代码仓库"
    },
    {
      "start": 47.433,
      "end": 49.15,
      "text": "也可以顺手接上飞书群"
    },
    {
      "start": 49.35,
      "end": 51.45,
      "text": "有权限的人在群里提需求"
    },
    {
      "start": 51.783,
      "end": 53.367,
      "text": "它自己开一个工作区去做"
    },
    {
      "start": 53.75,
      "end": 55.45,
      "text": "做完回到原来的会话里回复"
    },
    {
      "start": 55.75,
      "end": 57.25,
      "text": "比如直接提一个PR"
    },
    {
      "start": 57.517,
      "end": 59.067,
      "text": "几件事情可以同时推进"
    },
    {
      "start": 59.267,
      "end": 59.867,
      "text": "互不打断"
    },
    {
      "start": 60.217,
      "end": 62.017,
      "text": "背后是一套分层设计"
    },
    {
      "start": 62.167,
      "end": 64.183,
      "text": "上面一层只负责派活和回话"
    },
    {
      "start": 64.483,
      "end": 66.05,
      "text": "下面一层是互不干扰的"
    },
    {
      "start": 66.133,
      "end": 67.333,
      "text": "执行单元各干各的"
    },
    {
      "start": 67.683,
      "end": 69.75,
      "text": "所以它在后台跑长任务时"
    },
    {
      "start": 70.233,
      "end": 72.183,
      "text": "前台照样能接收新指令"
    },
    {
      "start": 72.367,
      "end": 73.867,
      "text": "笔记本合上了任务也不断"
    },
    {
      "start": 73.867,
      "end": 76.233,
      "text": "外面还挂了一个独立的看门狗"
    },
    {
      "start": 76.267,
      "end": 79.833,
      "text": "专门盯每个任务有没有真正在往前推进"
    },
    {
      "start": 80.567,
      "end": 82.567,
      "text": "文章给了一组初步数据"
    },
    {
      "start": 82.817,
      "end": 85.217,
      "text": "任务完成中位数12.4分"
    },
    {
      "start": 86.067,
      "end": 87.017,
      "text": "作者自己也说"
    },
    {
      "start": 87.683,
      "end": 90.733,
      "text": "实验用的是合成的负载和简化环境"
    },
    {
      "start": 90.983,
      "end": 94.267,
      "text": "只能当初步参考"
    },
    {
      "start": 94.717,
      "end": 95.767,
      "text": "有一点得说清楚"
    },
    {
      "start": 96.133,
      "end": 97.083,
      "text": "仓库里写得很明白"
    },
    {
      "start": 97.167,
      "end": 97.883,
      "text": "这是研究原型"
    },
    {
      "start": 97.95,
      "end": 100.083,
      "text": "不是DeepSeek的正式产品"
    },
    {
      "start": 100.833,
      "end": 102.983,
      "text": "为了公开做过改编"
    },
    {
      "start": 103.133,
      "end": 103.683,
      "text": "想试的话"
    },
    {
      "start": 103.867,
      "end": 105.917,
      "text": "先去仓库看安装文档"
    },
    {
      "start": 106.033,
      "end": 108.767,
      "text": "前提是你本来就在用DeepSeekHarness"
    },
    {
      "start": 109.083,
      "end": 110.083,
      "text": "接着是苹果"
    },
    {
      "start": 110.233,
      "end": 111.133,
      "text": "10月31日"
    },
    {
      "start": 111.333,
      "end": 114.133,
      "text": "苹果宣布国行版Apple智能要来了"
    },
    {
      "start": 114.517,
      "end": 116.067,
      "text": "部分体验接入了千问"
    },
    {
      "start": 116.883,
      "end": 121.967,
      "text": "你可以直接在Siri写作工具和视觉智能里用它"
    },
    {
      "start": 122.15,
      "end": 124.417,
      "text": "登录自己的千问账号或者通过 Apple 登录"
    },
    {
      "start": 125.467,
      "end": 130.517,
      "text": "阿里说，用户的请求和回复不会被拿去训练模型"
    },
    {
      "start": 131.033,
      "end": 132.983,
      "text": "时间是11月4日"
    },
    {
      "start": 133.15,
      "end": 136.133,
      "text": "随 iOS 开发者开始测试"
    },
    {
      "start": 136.333,
      "end": 138.817,
      "text": "12 月随 iOS 27.3 正式推送"
    },
    {
      "start": 139.083,
      "end": 140.167,
      "text": "机型有门槛"
    },
    {
      "start": 140.467,
      "end": 142.883,
      "text": "需要是iPhone16之后"
    },
    {
      "start": 143.067,
      "end": 145.967,
      "text": "然后相关的较新的系列"
    },
    {
      "start": 148.267,
      "end": 150.0,
      "text": "第三个是开源模型"
    },
    {
      "start": 150.617,
      "end": 151.517,
      "text": "10月31日"
    },
    {
      "start": 151.7,
      "end": 155.933,
      "text": "国内的开源这个模型，权重和代码都放出来了"
    },
    {
      "start": 156.3,
      "end": 158.317,
      "text": "它做的是生物分子结构预测"
    },
    {
      "start": 158.433,
      "end": 159.2,
      "text": "抗体，蛋白"
    },
    {
      "start": 159.283,
      "end": 160.717,
      "text": "小分子，这几类都能算"
    },
    {
      "start": 160.717,
      "end": 162.117,
      "text": "官方给出的数字是"
    },
    {
      "start": 162.267,
      "end": 165.383,
      "text": "抗体抗原测试集成功率75%"
    },
    {
      "start": 165.383,
      "end": 170.183,
      "text": "和这个平台上公布的75.6%差不多"
    },
    {
      "start": 170.467,
      "end": 171.783,
      "text": "他们还自己做了个实验"
    },
    {
      "start": 171.967,
      "end": 173.833,
      "text": "17 个靶点都拿到了候选"
    },
    {
      "start": 173.983,
      "end": 177.967,
      "text": "这些数都是公司自己报的"
    },
    {
      "start": 178.033,
      "end": 178.983,
      "text": "第三方还没有复核"
    },
    {
      "start": 178.983,
      "end": 180.517,
      "text": "以上是本期 AI 资讯"
    },
    {
      "start": 180.7,
      "end": 181.967,
      "text": "相关链接放在简介里"
    },
    {
      "start": 182.067,
      "end": 182.917,
      "text": "我们下期再见"
    }
  ]
}
