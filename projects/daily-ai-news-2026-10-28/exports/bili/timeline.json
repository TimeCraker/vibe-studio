  "cues": [
    {
      "start": 14.133,
      "end": 15.467,
      "text": "各位观众们大家好"
    },
    {
      "start": 16.117,
      "end": 17.583,
      "text": "欢迎收看今日AI资讯"
    },
    {
      "start": 18.233,
      "end": 22.417,
      "text": "今天的头条是Liquid AI发布LFM3"
    },
    {
      "start": 22.7,
      "end": 24.883,
      "text": "一组面向本地应用的小模型"
    },
    {
      "start": 25.533,
      "end": 29.333,
      "text": "Liquid AI在10月27日发布了这个系列"
    },
    {
      "start": 29.983,
      "end": 32,
      "text": "首批模型主要在20亿参数左右"
    },
    {
      "start": 32.517,
      "end": 34.817,
      "text": "分别处理文字、图片、声音"
    },
    {
      "start": 35.033,
      "end": 37.117,
      "text": "或者把这些输入放在一起整理"
    },
    {
      "start": 37.4,
      "end": 38.9,
      "text": "开发者可以下载权重"
    },
    {
      "start": 39.217,
      "end": 40.9,
      "text": "再针对自己的任务做微调"
    },
    {
      "start": 41.317,
      "end": 43.917,
      "text": "其中文本模型约17亿参数"
    },
    {
      "start": 44.133,
      "end": 44.967,
      "text": "官方介绍"
    },
    {
      "start": 45.167,
      "end": 48.6,
      "text": "4位量化后的模型本体约占1GB"
    },
    {
      "start": 48.967,
      "end": 51.117,
      "text": "能在手机和笔记本上运行"
    },
    {
      "start": 51.433,
      "end": 52.333,
      "text": "实际使用时"
    },
    {
      "start": 52.483,
      "end": 55.583,
      "text": "上下文缓存和应用程序还需要额外内存"
    },
    {
      "start": 56.233,
      "end": 58.417,
      "text": "同一系列还提供决策模型"
    },
    {
      "start": 58.633,
      "end": 59.433,
      "text": "官方演示中"
    },
    {
      "start": 59.817,
      "end": 62.133,
      "text": "你用一句话描述要找的物体"
    },
    {
      "start": 62.467,
      "end": 64.883,
      "text": "模型就会在画面中标出位置"
    },
    {
      "start": 65.283,
      "end": 67.317,
      "text": "这类能力可以接到具体应用里"
    },
    {
      "start": 67.7,
      "end": 68.7,
      "text": "用来处理图片"
    },
    {
      "start": 69.083,
      "end": 69.8,
      "text": "筛选信息"
    },
    {
      "start": 70.117,
      "end": 71.617,
      "text": "或者调用相应的工具"
    },
    {
      "start": 72.283,
      "end": 73.8,
      "text": "不过小模型有边界"
    },
    {
      "start": 74.017,
      "end": 75.1,
      "text": "官方明确提醒"
    },
    {
      "start": 75.3,
      "end": 77.317,
      "text": "这个17亿参数的文本模型"
    },
    {
      "start": 77.5,
      "end": 81.283,
      "text": "不推荐用于复杂的智能体编程或多步推理"
    },
    {
      "start": 81.633,
      "end": 84.417,
      "text": "更合适的方向是先挑一个明确任务"
    },
    {
      "start": 84.733,
      "end": 86.867,
      "text": "再测试它能不能稳定地完成"
    },
    {
      "start": 87.567,
      "end": 89.133,
      "text": "接下来看看文档识别"
    },
    {
      "start": 89.317,
      "end": 93.2,
      "text": "OpenBMB开放了MiniCPM-OCR"
    },
    {
      "start": 93.667,
      "end": 96,
      "text": "识别模型大约13亿参数"
    },
    {
      "start": 96.3,
      "end": 98.567,
      "text": "可以处理中文和英文的扫描件"
    },
    {
      "start": 99.083,
      "end": 101.533,
      "text": "照片，以及带表格和公式的文档"
    },
    {
      "start": 101.783,
      "end": 104.167,
      "text": "再把内容整理成Markdown格式"
    },
    {
      "start": 104.167,
      "end": 106.733,
      "text": "它还有一个约20亿的参数搭档"
    },
    {
      "start": 106.867,
      "end": 110.333,
      "text": "叫Jev，负责给识别结果打质量分"
    },
    {
      "start": 110.867,
      "end": 115.1,
      "text": "比如一页文档里的表格或公式识别得不可靠"
    },
    {
      "start": 115.333,
      "end": 117.317,
      "text": "就可以把这些区域挑出来复核"
    },
    {
      "start": 117.767,
      "end": 119.767,
      "text": "它是在帮助定位可疑结果"
    },
    {
      "start": 119.983,
      "end": 122.533,
      "text": "不能保证文档没有错误文字"
    },
    {
      "start": 122.533,
      "end": 124.117,
      "text": "国产小模型方面"
    },
    {
      "start": 124.633,
      "end": 129.5,
      "text": "讯飞团队发布了Spark-X2.6-1.7B"
    },
    {
      "start": 129.783,
      "end": 131.417,
      "text": "它沿用了上一代的架构"
    },
    {
      "start": 131.6,
      "end": 134.083,
      "text": "通过后训练强化代码和智能体任务"
    },
    {
      "start": 134.367,
      "end": 137.967,
      "text": "并提供不思考低强度和高强度三档思考预算"
    },
    {
      "start": 138.433,
      "end": 139.767,
      "text": "开发者可以根据任务"
    },
    {
      "start": 139.933,
      "end": 142.917,
      "text": "在响应速度和推理开销之间做选择"
    },
    {
      "start": 143.583,
      "end": 145.833,
      "text": "权重按此协议开放"
    },
    {
      "start": 146.2,
      "end": 148.267,
      "text": "官方模型页有部署方法"
    },
    {
      "start": 148.783,
      "end": 151.317,
      "text": "蚂蚁百灵也有一条权重开放的更新"
    },
    {
      "start": 152,
      "end": 155.033,
      "text": "此模型已经能在官方仓库下载"
    },
    {
      "start": 155.2,
      "end": 157.433,
      "text": "模型页标注MIT许可证"
    },
    {
      "start": 157.667,
      "end": 159.717,
      "text": "支持100万Token的上下文"
    },
    {
      "start": 159.967,
      "end": 162.517,
      "text": "它的体量比前面几款本地小模型大得多"
    },
    {
      "start": 162.917,
      "end": 165.567,
      "text": "自行部署前仍需评估服务器资源"
    },
    {
      "start": 166.033,
      "end": 167.817,
      "text": "再补一条开发者安全提醒"
    },
    {
      "start": 168.217,
      "end": 173.867,
      "text": "微软在10月25日发布了安全更新"
    },
    {
      "start": 173.933,
      "end": 176.167,
      "text": "修复解压库漏洞"
    },
    {
      "start": 176.433,
      "end": 178.217,
      "text": "相关更新以微软公告为准"
    }
  ],
  "subtitleTiming": "real-ASR-word-windows-agent-reviewed-human-listening-pending",
  "voice": "human-recorded"
}
