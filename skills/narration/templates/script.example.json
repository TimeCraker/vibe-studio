    { "id": 1, "kind": "subtitle", "text": "这一局我们打 B 区。", "ref": "footage 0:00-0:04" },
    { "id": 2, "kind": "subtitle", "text": "上隧道推进，队友先顶出去。", "ref": "footage 0:04-0:08" },
    { "id": 3, "kind": "subtitle", "text": "B 口接火，配合队友直接双杀。", "ref": "footage 0:08-0:12" },
    { "id": 4, "kind": "subtitle", "text": "进 B 换弹，准备下包。", "ref": "footage 0:12-0:15" },
