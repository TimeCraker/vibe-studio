    { "id": 6, "kind": "subtitle", "text": "包已下好，四十秒倒计时。", "ref": "footage 0:19-0:22" },
    { "id": 7, "kind": "subtitle", "text": "卡住方向守包，等对手来撞。", "ref": "footage 0:22-0:26" },
    { "id": 8, "kind": "subtitle", "text": "回合胜利，三杀拿下 MVP。", "ref": "footage 0:26-0:30" }
