  "cues": [
    {
      "start": 14.333,
      "end": 15.733,
      "text": "各位观众们大家好"
    },
    {
      "start": 15.967,
      "end": 17.533,
      "text": "欢迎收看今日AI资讯"
    },
    {
      "start": 18.017,
      "end": 19.917,
      "text": "今天的头条是OpenAI发布"
    },
    {
      "start": 19.917,
      "end": 21.4,
      "text": "GPT-6.1 Terra"
    },
    {
      "start": 21.8,
      "end": 24.617,
      "text": "主打看图理解和操作电脑"
    },
    {
      "start": 24.8,
      "end": 26.717,
      "text": "除此之外还有AI科研进展"
    },
    {
      "start": 27.083,
      "end": 29.4,
      "text": "让智能体积累工作经验的新研究"
    },
    {
      "start": 29.617,
      "end": 31.1,
      "text": "以及其他相关资讯"
    },
    {
      "start": 31.3,
      "end": 32.867,
      "text": "下面我们来看详细内容"
    },
    {
      "start": 33.867,
      "end": 36.4,
      "text": "先看GPT-6.1 Terra"
    },
    {
      "start": 36.833,
      "end": 39.9,
      "text": "OpenAI在10月26日的官方更新中"
    },
    {
      "start": 39.9,
      "end": 41.517,
      "text": "公布了这款新模型"
    },
    {
      "start": 41.883,
      "end": 44.533,
      "text": "它主要面向看懂屏幕、操作电脑"
    },
    {
      "start": 44.533,
      "end": 46.433,
      "text": "以及日常写作这类任务"
    },
    {
      "start": 46.883,
      "end": 48.517,
      "text": "比如，读取一张发票"
    },
    {
      "start": 48.717,
      "end": 51.2,
      "text": "再把里面的信息填进财务软件"
    },
    {
      "start": 51.583,
      "end": 53.433,
      "text": "这是官方给出的应用场景"
    },
    {
      "start": 54.033,
      "end": 56.717,
      "text": "对于需要让AI在多个软件之间"
    },
    {
      "start": 56.717,
      "end": 58.483,
      "text": "完成重复工作的开发者"
    },
    {
      "start": 58.683,
      "end": 60.283,
      "text": "这次更新值得关注"
    },
    {
      "start": 60.917,
      "end": 61.7,
      "text": "价格方面"
    },
    {
      "start": 62.167,
      "end": 66.417,
      "text": "标准接口的输入输出的单价都是上一代"
    },
    {
      "start": 66.417,
      "end": 68.8,
      "text": "GPT-5.6 Terra的一半"
    },
    {
      "start": 69.1,
      "end": 71.767,
      "text": "模型已经向ChatGPT Work"
    },
    {
      "start": 71.767,
      "end": 74.767,
      "text": "和Codex的相关付费用户开放"
    },
    {
      "start": 75.067,
      "end": 77.317,
      "text": "开发者也可以通过接口调用"
    },
    {
      "start": 78.2,
      "end": 80.683,
      "text": "具体在自己的任务上好不好用"
    },
    {
      "start": 80.833,
      "end": 81.933,
      "text": "还需要实际测试"
    },
    {
      "start": 83.383,
      "end": 85.067,
      "text": "再看一条科研消息"
    },
    {
      "start": 85.2,
      "end": 87.3,
      "text": "OpenAI在10月26日发布"
    },
    {
      "start": 87.517,
      "end": 90.283,
      "text": "内部AI模型在数学、计算机科学"
    },
    {
      "start": 90.283,
      "end": 91.317,
      "text": "和物理三个方向"
    },
    {
      "start": 91.317,
      "end": 93.267,
      "text": "产出了新的研究成果"
    },
    {
      "start": 94.517,
      "end": 98.917,
      "text": "其中，计算机科学的一项结果涉及指数时间假设"
    },
    {
      "start": 98.917,
      "end": 102.567,
      "text": "简单说，它讨论一类复杂的计算问题"
    },
    {
      "start": 102.567,
      "end": 104.717,
      "text": "到底有没有更快的算法"
    },
    {
      "start": 105.117,
      "end": 108.767,
      "text": "OpenAI声称找到了推翻这个假设的证明"
    },
    {
      "start": 109.1,
      "end": 110.117,
      "text": "如果结论成立"
    },
    {
      "start": 110.283,
      "end": 112.533,
      "text": "会影响相关问题的算法研究"
    },
    {
      "start": 112.817,
      "end": 116.967,
      "text": "但这不等于今天的软件马上就能跑得更快"
    },
    {
      "start": 117.367,
      "end": 119.533,
      "text": "把理论转成可用算法"
    },
    {
      "start": 119.917,
      "end": 121.983,
      "text": "还需要后续的工作"
    },
    {
      "start": 122.717,
      "end": 124.933,
      "text": "OpenAI已公开部分证明资料"
    },
    {
      "start": 125.1,
      "end": 127.667,
      "text": "并邀请外部学者继续核验和解释"
    },
    {
      "start": 127.833,
      "end": 129.867,
      "text": "现阶段，我们可以确认的是"
    },
    {
      "start": 129.867,
      "end": 132.7,
      "text": "这些研究材料和合作安排已经发布"
    },
    {
      "start": 133.083,
      "end": 136.867,
      "text": "具体结论的意义还要看后续学界的检验"
    },
    {
      "start": 138.933,
      "end": 142,
      "text": "接下来是一项让AI积累工作经验的研究"
    },
    {
      "start": 143.5,
      "end": 145.233,
      "text": "它想解决的问题是"
    },
    {
      "start": 145.567,
      "end": 146.9,
      "text": "AI做成了一件事"
    },
    {
      "start": 147.083,
      "end": 148.217,
      "text": "下次遇到类似任务"
    },
    {
      "start": 148.317,
      "end": 149.567,
      "text": "能不能少走一些弯路"
    },
    {
      "start": 149.567,
      "end": 153.7,
      "text": "研究人员让智能体把执行步骤和结果保存下来"
    },
    {
      "start": 153.817,
      "end": 155.383,
      "text": "经过检查之后"
    },
    {
      "start": 155.533,
      "end": 158.5,
      "text": "整理成可重复使用的工具和操作方法"
    },
    {
      "start": 158.9,
      "end": 161.767,
      "text": "之后再遇到类似问题"
    },
    {
      "start": 162.217,
      "end": 163.717,
      "text": "就先调用已有经验"
    },
    {
      "start": 163.917,
      "end": 164.617,
      "text": "执行出错"
    },
    {
      "start": 165.2,
      "end": 167.683,
      "text": "还会根据结果修正方法"
    },
    {
      "start": 168.117,
      "end": 170.317,
      "text": "感觉这个就有点像Skill啊"
    },
    {
      "start": 171.4,
      "end": 174.017,
      "text": "论文在30道软件修复任务"
    },
    {
      "start": 174.017,
      "end": 177.567,
      "text": "和一套科研计算流程上做了测试"
    },
    {
      "start": 178.4,
      "end": 179.467,
      "text": "作者报告"
    },
    {
      "start": 179.683,
      "end": 182.1,
      "text": "在已经累积经验的重复任务中"
    },
    {
      "start": 182.267,
      "end": 184.933,
      "text": "系统能减少反复尝试和处理成本"
    },
    {
      "start": 185.583,
      "end": 186.683,
      "text": "这里需要分清"
    },
    {
      "start": 186.8,
      "end": 188.933,
      "text": "这主要是在测试经验能不能复用"
    },
    {
      "start": 189.083,
      "end": 190.383,
      "text": "还不能据此判断"
    },
    {
      "start": 190.717,
      "end": 193.267,
      "text": "它面对全新问题也会有相同的表现"
    },
    {
      "start": 193.633,
      "end": 196.733,
      "text": "这项研究改进的是AI保存和复用经验的方法"
    },
    {
      "start": 197.083,
      "end": 198.017,
      "text": "值得持续关注"
    },
    {
      "start": 199.633,
      "end": 202.517,
      "text": "然后更新一下这款新模型的开放进度"
    },
    {
      "start": 202.717,
      "end": 205,
      "text": "这款模型已经提供了接口预览"
    },
    {
      "start": 205.233,
      "end": 206.783,
      "text": "但截至本期查询"
    },
    {
      "start": 206.933,
      "end": 210.333,
      "text": "官方模型页仍然显示等待发布"
    },
    {
      "start": 210.617,
      "end": 212.767,
      "text": "完整模型文件还没有开放下载"
    },
    {
      "start": 213.367,
      "end": 215.767,
      "text": "模型的公告说会在月底开放"
    },
    {
      "start": 216.067,
      "end": 218.867,
      "text": "Hugging Face上目前列出的"
    },
    {
      "start": 218.867,
      "end": 221.8,
      "text": "预计日期是10月31号"
    },
    {
      "start": 222.017,
      "end": 223.283,
      "text": "想自己部署朋友"
    },
    {
      "start": 223.567,
      "end": 225.7,
      "text": "还需要等正式文件和使用许可"
    },
    {
      "start": 226.133,
      "end": 228.167,
      "text": "最后是一条企业应用消息"
    },
    {
      "start": 228.283,
      "end": 232.117,
      "text": "甲骨文在当地时间10月26日公布了"
    },
    {
      "start": 232.117,
      "end": 233.817,
      "text": "帮助企业部署Fusion"
    },
    {
      "start": 234.167,
      "end": 237.967,
      "text": "云应用和AI智能体平台"
    },
    {
      "start": 238.417,
      "end": 241.217,
      "text": "这些智能体分工处理需求分析"
    },
    {
      "start": 241.417,
      "end": 242.267,
      "text": "应用设计"
    },
    {
      "start": 242.583,
      "end": 243.7,
      "text": "配置和测试"
    },
    {
      "start": 243.9,
      "end": 246.7,
      "text": "比如先把业务需求整理成设计文档"
    },
    {
      "start": 247.017,
      "end": 251.467,
      "text": "再生成配置原型并准备对应的测试用例"
    },
    {
      "start": 251.467,
      "end": 255.317,
      "text": "它主要服务正在部署甲骨文的企业软件的团队"
    },
    {
      "start": 255.417,
      "end": 257.6,
      "text": "对于其他开发者可以关注的是"
    },
    {
      "start": 258,
      "end": 261,
      "text": "它怎样把配置规则和产品经验"
    },
    {
      "start": 261,
      "end": 263.4,
      "text": "整理成AI能调用的技能"
    },
    {
      "start": 263.733,
      "end": 265.017,
      "text": "实际能节省多长时间"
    },
    {
      "start": 265.267,
      "end": 267.133,
      "text": "还要看具体项目效果"
    },
    {
      "start": 268.433,
      "end": 270.633,
      "text": "以上是本期精选资讯"
    },
    {
      "start": 270.833,
      "end": 271.533,
      "text": "我们下期再见"
    }
  ],
