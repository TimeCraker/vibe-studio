    },
    {
      "start": 39.9,
      "end": 42.36,
      "text": "不能把正式版说成已经开源",
      "scene": "longcat-office"
    },
    {
      "start": 43.3,
      "end": 48.54,
      "text": "接着补充看谷歌10月28日公布的此项模型",
      "scene": "carbon-release"
    },
    {
      "start": 48.78,
      "end": 50.84,
      "text": "官方重点强调两件事",
      "scene": "carbon-release"
    },
    {
      "start": 51.2,
      "end": 52.92,
      "text": "持续完成复杂工程任务",
      "scene": "carbon-release"
    },
    {
      "start": 53.18,
      "end": 56.02,
      "text": "以及发现、验证和修复软件漏洞",
      "scene": "carbon-release"
    },
    {
      "start": 56.24,
      "end": 58.66,
      "text": "按照谷歌公布的结果",
      "scene": "carbon-limits"
    },
    {
      "start": 59.02,
      "end": 62.14,
      "text": "Carbon在多项安全评测中取得提升",
      "scene": "carbon-limits"
    },
    {
      "start": 62.28,
      "end": 64.96,
      "text": "但这些成绩有各自的测试条件",
      "scene": "carbon-limits"
    },
    {
      "start": 65.2,
      "end": 67.8,
      "text": "不能直接当成我们日常使用时的结果",
      "scene": "carbon-limits"
    },
    {
      "start": 68.08,
      "end": 68.72,
      "text": "开放方面",
      "scene": "carbon-limits"
    },
    {
      "start": 69.32,
      "end": 73.68,
      "text": "公告先面向部分网络安全防御人员和可信合作伙伴",
      "scene": "carbon-limits"
    },
    {
      "start": 73.98,
      "end": 77.26,
      "text": "并不是宣布所有用户能够立即体验",
      "scene": "carbon-limits"
    },
    {
      "start": 78.4,
      "end": 79.58,
      "text": "谷歌另一项",
      "scene": "genie-world"
    },
    {
      "start": 82.11,
      "end": 84.59,
      "text": "值得看的进展",
      "scene": "genie-world"
    },
    {
      "start": 84.73,
      "end": 87.81,
      "text": "是10月27日发布的此项世界模型",
      "scene": "genie-world"
    },
    {
      "start": 88.01,
      "end": 89.67,
      "text": "它生成的场景可以交互",
      "scene": "genie-world"
    },
    {
      "start": 89.91,
      "end": 91.09,
      "text": "用键盘移动视角",
      "scene": "genie-world"
    },
    {
      "start": 91.09,
      "end": 93.85,
      "text": "也可以运用文字改变天气",
      "scene": "genie-world"
    },
    {
      "start": 93.95,
      "end": 94.65,
      "text": "添加角色",
      "scene": "genie-world"
    },
    {
      "start": 94.85,
      "end": 96.51,
      "text": "让场景持续演化",
      "scene": "genie-world"
    },
    {
      "start": 96.71,
      "end": 98.85,
      "text": "同时生成环境声音和对话",
      "scene": "genie-world"
    },
    {
      "start": 99.23,
      "end": 102.45,
      "text": "这给游戏原型和仿真研究提供了新的尝试方向",
      "scene": "genie-limits"
    },
    {
      "start": 102.69,
      "end": 106.45,
      "text": "不过，目前仍是面向可信测试者的研究预览",
      "scene": "genie-limits"
    },
    {
      "start": 107.03,
      "end": 109.35,
      "text": "连续交互是几分钟的级别",
      "scene": "genie-limits"
    },
    {
      "start": 109.59,
      "end": 112.25,
      "text": "画面一致性和声音准确性也有限制",
      "scene": "genie-limits"
    },
    {
      "start": 112.53,
      "end": 114.95,
      "text": "还不能把它当成成熟的游戏引擎",
      "scene": "genie-limits"
    },
    {
      "start": 115.63,
      "end": 118.63,
      "text": "再看今天发布的此项智能体评测",
      "scene": "gdpx-tasks"
    },
    {
      "start": 118.81,
      "end": 122.89,
      "text": "它覆盖芯片设计、软件工程、法律等11个领域",
      "scene": "gdpx-tasks"
    },
    {
      "start": 123.03,
      "end": 124.61,
      "text": "共206个任务",
      "scene": "gdpx-tasks"
    },
    {
      "start": 124.79,
      "end": 128.31,
      "text": "模型需要在复杂的文件和工具环境里完成工作",
      "scene": "gdpx-tasks"
    },
    {
      "start": 128.53,
      "end": 129.75,
      "text": "不只是回答一道题",
      "scene": "gdpx-tasks"
    },
    {
      "start": 129.75,
      "end": 131.63,
      "text": "在当前的默认榜单上",
      "scene": "gdpx-scores"
    },
    {
      "start": 131.95,
      "end": 134.65,
      "text": "最高综合得分是12%。注意",
      "scene": "gdpx-scores"
    },
    {
      "start": 134.85,
      "end": 136.75,
      "text": "这是评测下的综合分数",
      "scene": "gdpx-scores"
    },
    {
      "start": 136.97,
      "end": 139.21,
      "text": "混合了不同任务的评分方式",
      "scene": "gdpx-scores"
    },
    {
      "start": 139.49,
      "end": 143.59,
      "text": "不代表模型在现实工作中只有12%的成功率",
      "scene": "gdpx-scores"
    },
    {
      "start": 143.97,
      "end": 145.47,
      "text": "它更值得我们关注的是",
      "scene": "gdpx-scores"
    },
    {
      "start": 145.69,
      "end": 146.69,
      "text": "模型能给出答案",
      "scene": "gdpx-scores"
    },
    {
      "start": 147.03,
      "end": 148.99,
      "text": "和能把复杂工作可靠的完成",
      "scene": "gdpx-scores"
    },
    {
      "start": 149.55,
      "end": 151.03,
      "text": "中间还有哪些差距",
      "scene": "gdpx-scores"
    },
    {
      "start": 151.37,
